Family=Noto Sans CJK KR;whiteSpace=nowrap;html=0;rounded=0;strokeColor=#5EEAD4;strokeWidth=1;fillColor=#F0FDFA;fontColor=#0F766E;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1360" y="717" width="110" height="74" as="geometry" /></mxCell><mxCell id="tunnel-ip-note" value="ESP 인증 대상 아님" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="350" y="802" width="170" height="26" as="geometry" /></mxCell><mxCell id="tunnel-aad-note" value="AAD" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#0F766E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="802" width="130" height="26" as="geometry" /></mxCell><mxCell id="tunnel-iv-note" value="비밀 아님" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#92400E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="650" y="802" width="120" height="26" as="geometry" /></mxCell><mxCell id="tunnel-enc-note" value="원본 IP 패킷 전체 + ESP trailer 보호" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#1D4ED8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="770" y="802" width="590" height="26" as="geometry" /></mxCell><mxCell id="tunnel-tag-note" value="인증 태그" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#0F766E;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="802" width="110" height="26" as="geometry" /></mxCell><mxCell id="bottom-summary" value="핵심 차이: 전송 모드는 상위 계층을, 터널 모드는 원본 IP 패킷 전체를 숨긴다." style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;fontColor=#10213D;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="895" width="1480" height="34" as="geometry" /></mxCell><mxCell id="integrity-note" value="인증: ESP 헤더(SPI · Seq)는 AAD. Tag는 AAD와 암호문을 인증한다. 외부 IP 헤더는 ESP 인증 대상이 아님." style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#516079;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="1480" height="28" as="geometry" /></mxCell><mxCell id="iv-note" value="Explicit IV는 암호화 밖에 있으며 IV는 비밀이 아님. ESP trailer = Padding · Pad Length · Next Header." style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#516079;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="1480" height="27" as="geometry" /></mxCell><mxCell id="scale-note" value="개념도: 필드 폭은 정확한 바이트 비율이 아님 · IPv4/기본 ESP 구성, 옵션·NAT-T·ESN 세부 생략 · RFC 4303 / RFC 4106" style="fontFamily=Noto Sans CJK KR;whiteSpace=nowrap;html=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#7A879B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1480" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>